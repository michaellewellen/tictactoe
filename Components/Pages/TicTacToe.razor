@page "/TicTacToe/{id:int}"

@inject IConfiguration Configuration
@using System.Runtime.InteropServices
@using Dapper
@using Microsoft.AspNetCore.Authentication.OAuth.Claims
@using Npgsql
@rendermode InteractiveServer

<p>@message</p>

<div class="board">
    @for (int i = 0; i < 9; i++)
    {
        int index = i;
        <div class="cell" @onclick="() => CellClicked(index)">
            @board[index]
        </div>
    }
</div>
@if (gameOver)
{
    <button class="play-again" @onclick="NewGame">Play again?</button>
}

@code {
    [Parameter]
    public int id { get; set; }
    private bool busy = false;
    private string?[] board = new string?[9];
    private bool gameOver = false;
    private string message = "";

    private record Move(int Position, string Piece);

    private static readonly int[][] WinningLines =
    {
        new[] {0,1,2}, new[] {3,4,5}, new[] {6,7,8},   // rows
        new[] {0,3,6}, new[] {1,4,7}, new[] {2,5,8},   // columns
        new[] {0,4,8}, new[] {2,4,6}                   // diagonals
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();

        if (board.All(cell => cell == null))
        {
            message = "Game not started";
        }
        else
        {
            message = $"Game : {id}";
        }
        CheckGameState();

    }

    private async Task LoadBoardAsync()
    {
        Array.Clear(board);

        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        var moves = await conn.QueryAsync<Move>(
            "SELECT position, piece FROM tictactoe WHERE game_id = @Id",
            new { Id = id });

        foreach (var m in moves)
        {
            board[m.Position] = m.Piece;
        }
    }

    private string? CheckWinner(string?[] b)
    {
        foreach (var line in WinningLines)
        {
            if (b[line[0]] != null && b[line[0]] == b[line[1]] && b[line[1]] == b[line[2]])
            {
                return b[line[0]];
            }
        }
        return null;
    }

    private async Task CellClicked(int index)
    {
        if (busy) return;
        if (gameOver) return;        
        if (board[index] != null) return;

        busy = true;
        try{
            await InsertMove(index, "X");
            await LoadBoardAsync();
            CheckGameState();
            if (gameOver) return;


            message = "Computer is thinking ...";
            StateHasChanged();
            await Task.Delay(500);

            int computerMove = GetComputerMove();
            await InsertMove(computerMove,"O");
            await LoadBoardAsync();
            CheckGameState();

            if (!gameOver) message = "Your move!";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task InsertMove(int position, string piece)
    {
        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        await conn.ExecuteAsync(
            "INSERT INTO tictactoe (game_id, position, piece) VALUES (@GameId, @Position, @Piece)",
            new { GameId = id, Position = position, Piece = piece });
    }
    private void CheckGameState()
    {
        string? winner = CheckWinner(board);
        if (winner != null)
        {
            gameOver = true;
            message = $"Winner: {winner}";
        }
        else if (board.All(cell => cell != null))
        {
            gameOver = true;
            message = "It's a draw!";
        }
    }

    private int GetComputerMove()
    {
        return FindLineMove("O")
            ?? FindLineMove("X")
            ?? (board[4] == null ? 4 : RandomOpenSquare());
    }
    private int? FindLineMove(string piece)
    {
        foreach (int[] line in WinningLines)
        {
            if((line.Count(pos => board[pos] == piece) == 2) && (line.Count(pos => board[pos] == null) == 1))
                return line.First(pos => board[pos] == null);
        }
        return null;
    }
    private int RandomOpenSquare()
    {
        List<int> open = Enumerable.Range(0,9).Where(i => board[i] == null).ToList();
        return open[Random.Shared.Next(open.Count)];
    }

    private async Task NewGame()
    {
        await using var conn = new NpgsqlConnection(
            Configuration.GetConnectionString("DefaultConnection"));

        await conn.ExecuteAsync(
            "DELETE FROM tictactoe WHERE game_id = @Id",
            new { Id = id });
        
        await LoadBoardAsync();

        gameOver = false;
        message = "It's your move";
    }
}